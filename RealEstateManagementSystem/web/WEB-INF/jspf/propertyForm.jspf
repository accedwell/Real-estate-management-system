<%@page import="ac.za.tut.util.Icon"%>
<%@page import="ac.za.tut.entities.Property"%>
<%@page import="ac.za.tut.entities.User"%>
<%@page import="ac.za.tut.util.Html"%>
<%@page import="java.util.List"%>
<%--
    Shared property form fields. The including page sets:
      Property pf   - values to pre-fill (may be null for a new property)
      List<User> pfOwners - owners for the dropdown
--%>
<%
    String[] pfTypes = {"House", "Apartment", "Condo", "Townhouse", "Office"};
    String[] pfStatuses = {"Available", "Rented", "Sold"};
%>
<div class="form-grid">
    <div class="field full">
        <label for="ownerID">Owner</label>
        <select id="ownerID" name="ownerID" required>
            <option value="" disabled <%= pf == null ? "selected" : "" %>>Choose the owner&hellip;</option>
            <% if (pfOwners != null) for (User o : pfOwners) { %>
                <option value="<%= o.getUserID() %>" <%= (pf != null && pf.getOwnerID() == o.getUserID()) ? "selected" : "" %>>
                    <%= Html.esc(o.getName()) %> (ID <%= o.getUserID() %>)
                </option>
            <% } %>
        </select>
        <% if (pfOwners == null || pfOwners.isEmpty()) { %>
            <p class="hint">No owners exist yet. Ask an administrator to create an Owner account first.</p>
        <% } %>
    </div>
    <div class="field full">
        <label for="address">Address</label>
        <input type="text" id="address" name="address" maxlength="255" required placeholder="12 Jacaranda Street, Pretoria, 0002"
               value="<%= pf != null ? Html.esc(pf.getAddress()) : "" %>">
    </div>
    <div class="field">
        <label for="type">Property type</label>
        <select id="type" name="type" required>
            <% for (String t : pfTypes) { %>
                <option <%= (pf != null && t.equals(pf.getType())) ? "selected" : "" %>><%= t %></option>
            <% } %>
        </select>
    </div>
    <div class="field">
        <label for="status">Listing status</label>
        <select id="status" name="status" required>
            <% for (String s : pfStatuses) { %>
                <option <%= (pf != null && s.equals(pf.getStatus())) ? "selected" : "" %>><%= s %></option>
            <% } %>
        </select>
    </div>
    <div class="field">
        <label for="size">Size (m&sup2;)</label>
        <input type="number" id="size" name="size" min="1" required placeholder="e.g. 120"
               value="<%= (pf != null && pf.getSize() > 0) ? pf.getSize() : "" %>">
    </div>
    <div class="field">
        <label for="rooms">Rooms</label>
        <input type="number" id="rooms" name="rooms" min="0" max="200" required
               value="<%= pf != null ? pf.getRooms() : 1 %>">
    </div>
</div>
