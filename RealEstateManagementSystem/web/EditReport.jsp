<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@page import="ac.za.tut.dao.UserDAO"%>
<%@page import="ac.za.tut.entities.Report"%>
<%@page import="ac.za.tut.entities.User"%>
<%@page import="ac.za.tut.util.Html"%>
<%@page import="java.util.List"%>
<%
    Report rep = (Report) request.getAttribute("reportObj");
    if (rep == null) { response.sendRedirect("Reports.jsp"); return; }
    List<User> users = (List<User>) request.getAttribute("users");
    if (users == null) { users = new UserDAO().getAllUsers(); }
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <%@ include file="/WEB-INF/jspf/head.jspf" %>
    <title>Edit Report | REMS</title>
</head>
<body>
<%@ include file="/WEB-INF/jspf/nav.jspf" %>

<section class="page-hero h-reports">
    <div class="page-hero-inner">
        <div class="crumbs"><a href="Welcome.jsp">Dashboard</a> / <a href="Reports.jsp">Reports</a> / Edit</div>
        <h1>Edit report record #<%= rep.getReportID() %></h1>
        <p>Correct the details stored in the report log.</p>
    </div>
</section>

<main class="page page-narrow">
    <div class="card">
        <%@ include file="/WEB-INF/jspf/alerts.jspf" %>
        <form action="ReportServlet" method="POST">
            <input type="hidden" name="action" value="update">
            <input type="hidden" name="reportID" value="<%= rep.getReportID() %>">
            <div class="form-grid">
                <div class="field">
                    <label for="type">Report type</label>
                    <input type="text" id="type" name="type" maxlength="50" required value="<%= Html.esc(rep.getType()) %>">
                </div>
                <div class="field">
                    <label for="generatedBy">Generated by</label>
                    <select id="generatedBy" name="generatedBy" required>
                        <% for (User u : users) { %>
                            <option value="<%= u.getUserID() %>" <%= u.getUserID() == rep.getGeneratedBy() ? "selected" : "" %>><%= Html.esc(u.getName()) %> (ID <%= u.getUserID() %>)</option>
                        <% } %>
                    </select>
                </div>
                <div class="field">
                    <label for="date">Date</label>
                    <input type="date" id="date" name="date" required value="<%= rep.getDate() != null ? rep.getDate() : "" %>">
                </div>
                <div class="field">
                    <label for="filePath">File path</label>
                    <input type="text" id="filePath" name="filePath" maxlength="255" required value="<%= Html.esc(rep.getFilePath()) %>">
                </div>
            </div>
            <div class="form-actions">
                <a class="btn btn-outline" href="Reports.jsp">Cancel</a>
                <button type="submit" class="btn btn-dark">Save changes</button>
            </div>
        </form>
    </div>
</main>

<%@ include file="/WEB-INF/jspf/footer.jspf" %>
</body>
</html>
